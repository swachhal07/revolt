# Copy to `.env` and fill in. This file is committed; `.env` is not.
#
# Every VITE_* variable is inlined into the JavaScript bundle at build time, so
# none of these is a secret — they exist so values can differ between machines and
# deploys. Never put a Cloudinary API secret, a database URL or anything genuinely
# private in either file.

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Powers image uploading in the admin. Both now fall back to the project's own
# cloud and preset in src/admin/data/media.js, so leaving them blank keeps
# uploading working; set them only to point a machine at a different cloud.
#
# The preset must be UNSIGNED. A signed upload needs the API secret to build its
# signature, and a secret in a static frontend is public. Create it under
# Settings → Upload → Upload presets, set Signing Mode to Unsigned, and cap the
# file size and formats there rather than only in the browser.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Admin password ───────────────────────────────────────────────────────────
# Applies to the `local` backend only, where it is checked in the browser and
# ships in the bundle — it keeps the tool out of the way of casual visitors and
# is not authentication. The default lives in src/admin/data/session.js.
#
# With `http` the password is checked by the API against a secret the browser
# never sees and this variable is ignored, which is the whole reason to prefer
# it.
VITE_ADMIN_PASSWORD=

# ── Admin data source ────────────────────────────────────────────────────────
# `local` (the default) keeps records in this browser's localStorage, seeded from
# src/data/*. Edits never reach the live site, and the admin shows a standing
# notice saying so.
#
# `http` talks to the Node service in `backend/` — real storage, a real password
# check, and authenticated image uploads. It needs VITE_API_URL set to the API's
# origin with no trailing slash and no path; the admin throws on startup rather
# than silently posting to its own origin if it is missing.
#
# Adapters are registered in src/admin/data/index.js.
VITE_ADMIN_BACKEND=local
VITE_API_URL=
