# Copy to `.env` and fill in. This file is committed; `.env` is not.
#
# Every VITE_* variable is inlined into the JavaScript bundle at build time, so
# none of these is a secret — they exist so values can differ between machines and
# deploys. Never put a Cloudinary API secret, a database URL or anything genuinely
# private in either file.

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Powers image uploading in the admin. Without both of these the image fields
# still work — they take a pasted URL and the upload button is disabled.
#
# The preset must be UNSIGNED. A signed upload needs the API secret to build its
# signature, and a secret in a static frontend is public. Create it under
# Settings → Upload → Upload presets, set Signing Mode to Unsigned, and cap the
# file size and formats there rather than only in the browser.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Soft gates ───────────────────────────────────────────────────────────────
# Both are checked in the browser and both ship in the bundle. They keep things
# out of the way of casual visitors; neither is authentication. Defaults live in
# src/constants/launch.js and src/admin/backend/session.js.
VITE_LAUNCH_PASSWORD=
VITE_ADMIN_PASSWORD=

# ── Admin data source ────────────────────────────────────────────────────────
# `local` (the default) keeps records in the browser's localStorage, seeded from
# src/data/*. Register other adapters in src/admin/backend/index.js.
VITE_ADMIN_BACKEND=local
