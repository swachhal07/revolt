# Copy to `.env` for local development. On Render these are set in the
# dashboard, and `.env` is never deployed.
#
# This file is committed. Never put a real value in it — `.env` is gitignored,
# this is not.

# The port Render injects. Leave unset locally to use 4000.
# PORT=4000
NODE_ENV=development

# Who may call this API, comma separated, no trailing slash. The Vite dev server
# locally; the deployed frontend's origin in production. Vite falls back to
# another port when 5173 is taken, so list both if that keeps happening.
CORS_ORIGINS=http://localhost:5173

# The back office's one password, and the secret its session token is signed
# with. Generate the secret with: openssl rand -base64 48
ADMIN_PASSWORD=
JWT_SECRET=
# How long a signed-in session lasts.
TOKEN_TTL=12h

# Cloudinary is both the media host and the datastore — see src/store.js.
# The secret must never reach the frontend bundle.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Everything this service owns lives under this prefix.
CLOUDINARY_FOLDER=revolt

# Development only: keep records in the process instead of Cloudinary, so the API
# runs with just ADMIN_PASSWORD and JWT_SECRET set. Everything is lost on
# restart, and it refuses to start with NODE_ENV=production.
# STORE_DRIVER=memory
